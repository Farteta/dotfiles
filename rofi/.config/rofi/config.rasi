/* Midnight Aurora — application and command launcher */

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font Mono 12";
    show-icons: true;
    icon-theme: "breeze-dark";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    sidebar-mode: false;
}

* {
    bg:              #11141cee;
    surface:         #191d27f2;
    surface-hover:   #232936ff;
    border:          #343b4aff;
    foreground:      #e6eaf2ff;
    muted:           #929cadff;
    accent:          #7dcfffff;
    accent-soft:     #7dcfff24;
    urgent:          #f7768eff;

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 640px;
    border: 1px;
    border-color: @border;
    border-radius: 16px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    spacing: 10px;
    padding: 0;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 13px 15px;
    border: 1px;
    border-color: @border;
    border-radius: 11px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications, commands, and windows";
    placeholder-color: @muted;
    text-color: @foreground;
}

message {
    padding: 10px 12px;
    border: 0px;
    border-radius: 10px;
    background-color: @surface;
}

listview {
    border: 0px;
    lines: 7;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    children: [ element-icon, element-text ];
    spacing: 13px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @accent-soft;
    text-color: @foreground;
}

element selected.urgent {
    background-color: @urgent;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding: 8px 12px;
    border-radius: 9px;
    text-color: @muted;
}

button selected {
    background-color: @surface-hover;
    text-color: @accent;
}
